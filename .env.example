# Copy these into the Vercel project's Environment Variables (Settings → Environment Variables).
# Nothing here is needed for local design work — `npm run dev` logs enquiries to the terminal instead.

# From https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxx

# Where enquiries are delivered (Amy's inbox)
CONTACT_TO=amy@example.com

# Sender address. Must be on a domain verified in Resend, e.g. "Amy's Little Florist <hello@amyslittleflorist.co.uk>".
# Until the domain is verified you can use "onboarding@resend.dev" for testing.
CONTACT_FROM=Amy's Little Florist <onboarding@resend.dev>
